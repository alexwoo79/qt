{
    "tasks": [
        {
            // 原有任务：编译当前打开的单个文件，不带任何库参数。
            // 注意：用它编译用到 webview 的文件会报找不到 gtk 头文件，
            // 那种情况请用下面的 "webview: 编译当前文件"。
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            // 编译当前打开的单个文件，并带上 webview 需要的编译与链接参数。
            // 产物就放在源文件旁边，和上面那个任务的习惯一致。
            "type": "shell",
            "label": "webview: 编译当前文件",
            "command": "make -C ${workspaceFolder} -s obj/index_html.h && /usr/bin/g++ -fdiagnostics-color=always -g -Wall ${file} -o ${fileDirname}/${fileBasenameNoExtension} -I${workspaceFolder}/obj $(pkg-config --cflags --libs gtk4 webkitgtk-6.0) -ldl",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "先生成 obj/index_html.h（内嵌的页面），再用 pkg-config 的参数编译当前文件"
        },
        {
            // 走项目里的 Makefile，编译 src/ 下的所有 .cpp，产物是 myapp。
            "type": "shell",
            "label": "webview: 构建项目 (make)",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "运行 youtube/Makefile，产物为 myapp"
        },
        {
            // 先 make，再启动窗口程序；关掉窗口任务就结束。
            "type": "shell",
            "label": "webview: 构建并运行",
            "command": "${workspaceFolder}/myapp",
            "dependsOn": [
                "webview: 构建项目 (make)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "先 make，再启动 myapp"
        }
    ],
    "version": "2.0.0"
}
